# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optionnel - utilise SQLite par defaut)
# DATABASE_URL=postgresql://user:password@localhost:5432/mara

# Email (optionnel)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Web Push Notifications VAPID Keys (requis pour les notifications push)
# Generate keys with: openssl ecparam -genkey -name prime256v1 -out vapid_private.pem
# Then: openssl ec -in vapid_private.pem -pubout -out vapid_public.pem
# Convert to base64url format using a VAPID key generator tool
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_CLAIMS_SUB=mailto:admin@yourdomain.com
